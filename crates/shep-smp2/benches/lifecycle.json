    "source": "use shep_smp2::{Buffer, Config, Runtime, spawn};\nfn main() {\n let mut runtime=Runtime::new(Config::default()).unwrap();\n let file=runtime.io().file(tempfile::tempfile().unwrap());\n let start=std::time::Instant::now();\n for _ in 0..10000 {\n  let file=file.clone();\n  runtime.block_on(async move {\n   let mut joins=Vec::with_capacity(256);\n   for index in 0..256 {\n    let file=file.clone();\n    joins.push(spawn(async move {\n     let (result,_)=file.write_at(Buffer::new(4096,4096).unwrap(),index*4096).await;\n     assert_eq!(result.unwrap(),4096);\n    }));\n   }\n   for join in joins { join.await.unwrap(); }\n  }).unwrap();\n }\n println!(\"10000 batches: {:?}\",start.elapsed());\n}\n",
